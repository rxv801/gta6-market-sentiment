# Copy to .env and fill in. Never commit .env.

# Postgres (Supabase)
DATABASE_URL=postgresql://collector:password@host:5432/postgres

# YouTube Data API v3
YOUTUBE_API_KEY=

# Reddit (PRAW, script app)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=gta6-market-sentiment/0.1 by u/your_username

# Twitch Helix
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
