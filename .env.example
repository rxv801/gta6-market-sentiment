# Copy to .env and fill in. Never commit .env.

# Supabase admin login (Session pooler). Local only, for scripts/apply_schema.py and provision_collector.py
SUPABASE_ADMIN_URL=

# Collector login (insert only). Set in GitHub secrets by scripts/provision_collector.py
DATABASE_URL=

# YouTube Data API v3
YOUTUBE_API_KEY=

# Reddit (PRAW, script app)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=gta6-market-sentiment/0.1 by u/your_username

# Twitch Helix
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
