# Copy to .env and fill in. Never commit .env.

# Supabase admin login (Session pooler). Local only, for scripts/apply_schema.py and provision_role.py
SUPABASE_ADMIN_URL=

# Collector login (insert only). Set in GitHub secrets by scripts/provision_role.py
DATABASE_URL=

# YouTube Data API v3
YOUTUBE_API_KEY=

# Reddit (PRAW, script app)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=gta6-market-sentiment/0.1 by u/your_username

# Twitch Helix
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# dbt prod target: Supabase transformer role (Session pooler). dev uses local Postgres and needs nothing here.
DBT_PROD_HOST=
DBT_PROD_USER=
DBT_PROD_PASSWORD=
